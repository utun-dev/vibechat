# Выполняется после staging, до создания DEB. Частные SONAME принадлежат этому пакету.
set(stage "${CPACK_TEMPORARY_DIRECTORY}")
file(GLOB_RECURSE candidates "${stage}/opt/vibechat/bin/*" "${stage}/opt/vibechat/lib/*" "${stage}/opt/vibechat/plugins/*")
set(binaries)
set(shlibs)
foreach(binary IN LISTS candidates)
    if(IS_SYMLINK "${binary}")
        continue()
    endif()
    file(READ "${binary}" magic LIMIT 4 HEX)
    if(NOT magic STREQUAL "7f454c46")
        continue()
    endif()
    list(APPEND binaries "${binary}")
    execute_process(COMMAND "@DEB_readelf@" -d "${binary}" OUTPUT_VARIABLE dynamic RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect DEB ELF: ${binary}")
    endif()
    if(dynamic MATCHES "\\(SONAME\\)[^\n]*\\[([^]]+)\\]")
        set(soname "${CMAKE_MATCH_1}")
        if(soname MATCHES "^(.+)\\.so\\.(.+)$")
            string(APPEND shlibs "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} vibechat\n")
        elseif(soname MATCHES "^(.+)-([0-9].*)\\.so$")
            string(APPEND shlibs "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} vibechat\n")
        endif()
    endif()
endforeach()
if(NOT binaries)
    message(FATAL_ERROR "No ELF binaries staged for DEB dependencies")
endif()
file(MAKE_DIRECTORY "${stage}/debian" "${stage}/DEBIAN")
file(WRITE "${stage}/debian/control" "Source: vibechat\n\nPackage: vibechat\nArchitecture: any\nDescription: VibeChat\n")
file(WRITE "${stage}/debian/shlibs.local" "${shlibs}")
# Предупреждения о лишних линковках готовых сторонних библиотек не относятся к целостности runtime.
execute_process(COMMAND "@DEB_dpkg-shlibdeps@" --warnings=1 -O -xvibechat "-l${stage}/opt/vibechat/lib" ${binaries}
    WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result OUTPUT_VARIABLE dependencies ERROR_VARIABLE diagnostics
    OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0 OR NOT dependencies MATCHES "^shlibs:Depends=" OR dependencies MATCHES "\\$\\{")
    message(FATAL_ERROR "Cannot determine DEB system dependencies: ${dependencies}\n${diagnostics}")
endif()
if(NOT diagnostics STREQUAL "")
    message(STATUS "DEB dependency diagnostics: ${diagnostics}")
endif()
string(REGEX REPLACE "^shlibs:Depends=" "" dependencies "${dependencies}")
if(NOT dependencies STREQUAL "")
    string(APPEND CPACK_DEBIAN_PACKAGE_DEPENDS ", ${dependencies}")
endif()
file(REMOVE_RECURSE "${stage}/debian" "${stage}/DEBIAN")
message(STATUS "DEB external system dependencies: ${CPACK_DEBIAN_PACKAGE_DEPENDS}")
