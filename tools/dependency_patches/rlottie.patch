+/* Предупреждения встроенной библиотеки доступны и без LOTTIE_LOGGING_SUPPORT. */
+#define RLOTTIE_HAS_WARNING_CALLBACK 1
+typedef void (*Lottie_Warning_Callback)(const char *message);
+RLOTTIE_API void lottie_set_warning_callback(Lottie_Warning_Callback callback);
