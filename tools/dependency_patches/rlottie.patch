--- a/src/vector/vdebug.cpp
+++ b/src/vector/vdebug.cpp
@@ -21,6 +21,26 @@
  */
 
 #include "vdebug.h"
+#include "rlottie_capi.h"
+#include <atomic>
+#include <cstdarg>
+#include <cstdio>
+
+static std::atomic<Lottie_Warning_Callback> warningCallback{nullptr};
+
+extern "C" void lottie_set_warning_callback(Lottie_Warning_Callback callback) {
+    warningCallback.store(callback);
+}
+
+void lottieWarning(const char *format, ...) {
+    char message[1024];
+    va_list args;
+    va_start(args, format);
+    std::vsnprintf(message, sizeof(message), format, args);
+    va_end(args);
+    if (auto callback = warningCallback.load()) callback(message);
+    else std::fprintf(stderr, "[WARN] rlottie: %s\n", message);
+}
 
 #ifdef LOTTIE_LOGGING_SUPPORT
 
