{
    "$schema": "https://opencode.ai/config.json",
    "plugin": ["@isac322/kwin-mcp-opencode"],
    "mcp": {
        "kwin-mcp": {
            "type": "local",
            "command": ["/home/user/.local/bin/uvx", "kwin-mcp"],
            "enabled": true
        },
        "gdb-mcp": {
            "type": "local",
            "command": ["/home/user/.local/bin/uvx", "--with", "mcp<2", "gdb-mcp"],
            "enabled": true
        },
        "aiterm": {
            "type": "local",
            "command": ["/home/user/.npm-global/bin/aiterm-mcp"],
            "enabled": true
        }
    }
}
